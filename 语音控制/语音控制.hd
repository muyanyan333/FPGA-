erial_bin">HEX</field><field name="NAME" /><field name="huifu">为什么音符不迷路？因为它总能找到节拍。</field><next><block type="asr_easystart_recognize" id="voice_015"><field name="ASR">来个冷笑话</field><field name="IO">-</field><field name="IO_mode">-</field><field name="IO_status">-------</field><field name="serial">-</field><field name="serial_bin">HEX</field><field name="NAME" /><field name="huifu">为什么音符不迷路？因为它总能找到节拍。</field><next><block type="asr_easystart_recognize" id="voice_016"><field name="ASR">夸夸我</field><field name="IO">-</field><field name="IO_mode">-</field><field name="IO_status">-------</field><field name="serial">-</field><field name="serial_bin">HEX</field><field name="NAME" /><field name="huifu">你已经把图片、音乐和语音连在一起了，继续加油！</field><next><block type="asr_easystart_recognize" id="voice_017"><field name="ASR">鼓励我一下</field><field name="IO">-</field><field name="IO_mode">-</field><field name="IO_status">-------</field><field name="serial">-</field><field name="serial_bin">HEX</field><field name="NAME" /><field name="huifu">你已经把图片、音乐和语音连在一起了，继续加油！</field><next><block type="asr_easystart_recognize" id="voice_018"><field name="ASR">来句诗</field><field name="IO">-</field><field name="IO_mode">-</field><field name="IO_status">-------</field><field name="serial">-</field><field name="serial_bin">HEX</field><field name="NAME" /><field name="huifu">明月松间照，清泉石上流。</field><next><block type="asr_easystart_recognize" id="voice_019"><field name="ASR">念一句诗</field><field name="IO">-</field><field name="IO_mode">-</field><field name="IO_status">-------</field><field name="serial">-</field><field name="serial_bin">HEX</field><field name="NAME" /><field name="huifu">明月松间照，清泉石上流。</field><next><block type="asr_easystart_recognize" id="voice_020"><field name="ASR">今天开心吗</field><field name="IO">-</field><field name="IO_mode">-</field><field name="IO_status">-------</field><field name="serial">-</field><field name="serial_bin">HEX</field><field name="NAME" /><field name="huifu">能和你一起听歌看图，我很开心。</field><next